# Copiar a .env (NUNCA subir .env al repositorio)

# Seguridad: debe ser "true" para permitir operar con dinero real (además de la frase de confirmación en la UI)
ALLOW_LIVE_TRADING=false

# Servidor
HOST=127.0.0.1
PORT=8000

# InvertirOnline (opcional: también se pueden ingresar en la UI, quedan sólo en memoria)
IOL_USERNAME=
IOL_PASSWORD=
IOL_PLAZO=t1

# Primary API / Matba Rofex
PRIMARY_USER=
PRIMARY_PASSWORD=
PRIMARY_ACCOUNT=
PRIMARY_ENVIRONMENT=REMARKET
PRIMARY_SETTLEMENT=24hs
# Sólo LIVE (provistos por tu ALyC):
PRIMARY_API_URL=
PRIMARY_WS_URL=
